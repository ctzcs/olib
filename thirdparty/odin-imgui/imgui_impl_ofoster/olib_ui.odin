package imgui_impl_ofoster

// olib look for ImGui: the kit/ui typeface, a matching dark style, foster
// textures as ImTextureRef, and a small sheet of olib icons.
//
// Sections: font / style / foster textures / icons.

import "core:fmt"
import "core:math"
import "core:mem"
import "core:strings"

import imgui "../"
import foster "olib:foster"

// Base font size in points, before DPI and style scaling (kit/ui tool body text).
FONT_SIZE :: f32(16)

// ---- font ----------------------------------------------------------------------

// The olib UI font: Noto Sans CJK SC (ASCII, Latin-1 and GB2312), generated by
// olib/tools/fonts/imgui_font.py. Glyphs are rasterized on demand at the
// requested size, so Chinese labels need no baked charset.
font_load_default :: proc(size: f32) -> bool {
	data := #load("../../../assets/fonts/NotoSansCJKsc-Regular-subset.otf")
	// the atlas frees the font data it owns, so hand it an ImGui allocation
	// rather than the embedded read-only bytes
	owned := imgui.MemAlloc(uint(len(data)))
	if owned == nil {
		return false
	}
	mem.copy(owned, raw_data(data), len(data))
	io := imgui.GetIO()
	if imgui.FontAtlas_AddFontFromMemoryTTF(io.Fonts, owned, i32(len(data)), size) == nil {
		return false
	}
	imgui.GetStyle().FontSizeBase = size
	return true
}

// ---- style ---------------------------------------------------------------------

@(private)
rgba :: proc(r, g, b: u8, a: u8 = 255) -> imgui.Vec4 {
	return {f32(r)/255, f32(g)/255, f32(b)/255, f32(a)/255}
}

// Dark blue-gray palette with a light-blue accent, the same colors as the
// kit/ui tool theme, so ImGui tools sit next to kit/ui panels.
style_olib :: proc() {
	imgui.StyleColorsDark()
	style := imgui.GetStyle()
	style.WindowRounding = 4
	style.ChildRounding = 4
	style.FrameRounding = 3
	style.PopupRounding = 4
	style.GrabRounding = 3
	style.TabRounding = 3
	style.ScrollbarRounding = 6
	style.WindowPadding = {10, 10}
	style.FramePadding = {7, 4}
	style.ItemSpacing = {8, 6}
	style.ItemInnerSpacing = {6, 4}
	style.WindowBorderSize = 1
	style.FrameBorderSize = 0

	accent := rgba(117, 184, 255)
	palette := [?]struct {col: imgui.Col, color: imgui.Vec4}{
		{.Text, rgba(210, 219, 228)},
		{.TextDisabled, rgba(140, 154, 168)},
		{.WindowBg, rgba(22, 26, 33)},
		{.ChildBg, rgba(0, 0, 0, 0)},
		{.PopupBg, rgba(22, 26, 33, 250)},
		{.Border, rgba(43, 51, 60)},
		{.FrameBg, rgba(31, 38, 47)},
		{.FrameBgHovered, rgba(41, 51, 63)},
		{.FrameBgActive, rgba(36, 54, 77)},
		{.TitleBg, rgba(13, 16, 20)},
		{.TitleBgActive, rgba(22, 26, 33)},
		{.TitleBgCollapsed, rgba(13, 16, 20)},
		{.MenuBarBg, rgba(18, 22, 28)},
		{.ScrollbarBg, rgba(13, 16, 20, 160)},
		{.ScrollbarGrab, rgba(43, 51, 60)},
		{.ScrollbarGrabHovered, rgba(60, 72, 84)},
		{.ScrollbarGrabActive, rgba(78, 94, 110)},
		{.CheckMark, accent},
		{.SliderGrab, rgba(92, 150, 214)},
		{.SliderGrabActive, accent},
		{.Button, rgba(33, 41, 51)},
		{.ButtonHovered, rgba(44, 56, 69)},
		{.ButtonActive, rgba(36, 54, 77)},
		{.Header, rgba(36, 54, 77)},
		{.HeaderHovered, rgba(44, 66, 94)},
		{.HeaderActive, rgba(52, 78, 110)},
		{.Separator, rgba(43, 51, 60)},
		{.SeparatorHovered, rgba(92, 150, 214)},
		{.SeparatorActive, accent},
		{.ResizeGrip, rgba(43, 51, 60, 120)},
		{.ResizeGripHovered, rgba(92, 150, 214)},
		{.ResizeGripActive, accent},
		{.Tab, rgba(28, 34, 43)},
		{.TabHovered, rgba(44, 66, 94)},
		{.TabSelected, rgba(36, 54, 77)},
		{.TabSelectedOverline, accent},
		{.TabDimmed, rgba(18, 22, 28)},
		{.TabDimmedSelected, rgba(30, 40, 54)},
		{.DockingPreview, rgba(117, 184, 255, 150)},
		{.DockingEmptyBg, rgba(13, 16, 20)},
		{.TextSelectedBg, rgba(117, 184, 255, 90)},
		{.NavCursor, accent},
	}
	for entry in palette {
		style.Colors[entry.col] = entry.color
	}
}

// ---- foster textures -----------------------------------------------------------

// Texture wraps a foster texture (MSAA targets use their resolve texture) for
// imgui.Image and friends; sdlgpu3 samples it with its default linear sampler.
// The texture must stay alive until EndRender has drawn the frame.
Texture :: proc(texture: ^foster.Texture) -> imgui.TextureRef {
	if texture == nil || texture.Resource == nil {
		return {}
	}
	// since ImGui 1.92 the sdlgpu3 ImTextureID is the SDL_GPUTexture itself
	return {_TexID = imgui.TextureID(uintptr(foster.TextureSampleResource(texture)))}
}

// ---- icons ---------------------------------------------------------------------

// A sheet of named icons in straight alpha (the sdlgpu3 pipeline blends
// straight alpha), each scaled down to a cell x cell square.
Icons :: struct {
	texture: foster.Texture,
	uvs: map[string][2]imgui.Vec2, // uv min, uv max; keys owned
}

// IconsInit copies the named icons out of a straight-alpha image, e.g. the olib
// icon atlas from rendering2d.builtin_icons_decode, area-averaging each into a
// cell of `cell` pixels (about twice the drawn size keeps them smooth). Every
// name must exist in rects. Dispose with IconsDispose before the device.
IconsInit :: proc(icons: ^Icons, device: ^foster.GraphicsDevice, image: foster.Image,
	rects: map[string]foster.RectInt, names: []string, cell: int) -> bool {
	if device == nil || len(names) == 0 || cell <= 0 || len(image.Pixels) == 0 {
		return false
	}
	for name in names {
		if name not_in rects {
			fmt.eprintln("imgui_impl_ofoster: missing icon", name)
			return false
		}
	}
	gap := 2 // transparent border so bilinear sampling never reaches a neighbor
	stride := cell + gap*2
	columns := int(math.ceil(math.sqrt(f32(len(names)))))
	rows := (len(names) + columns - 1)/columns
	sheet := foster.ImageMake(columns*stride, rows*stride)
	defer foster.ImageDispose(&sheet)
	icons.uvs = make(map[string][2]imgui.Vec2, len(names))
	for name, i in names {
		x := (i%columns)*stride + gap
		y := (i/columns)*stride + gap
		icon_resample(&sheet, x, y, cell, image, rects[name])
		w, h := f32(sheet.Width), f32(sheet.Height)
		icons.uvs[strings.clone(name)] = {{f32(x)/w, f32(y)/h}, {f32(x+cell)/w, f32(y+cell)/h}}
	}
	icons.texture = foster.TextureFromImage(device, &sheet, "imgui icons")
	if icons.texture.Resource == nil {
		IconsDispose(icons)
		return false
	}
	return true
}

IconsDispose :: proc(icons: ^Icons) {
	if icons.texture.Resource != nil {
		foster.TextureDispose(&icons.texture)
	}
	for name in icons.uvs {
		delete(name)
	}
	delete(icons.uvs)
	icons^ = {}
}

// box filter in premultiplied space, written back as straight alpha
@(private)
icon_resample :: proc(sheet: ^foster.Image, x, y, cell: int, image: foster.Image, src: foster.RectInt) {
	scale := f32(src.Width)/f32(cell)
	taps := max(1, int(math.ceil(scale)))*2
	for dy in 0..<cell {
		for dx in 0..<cell {
			sum: [4]f32
			for ty in 0..<taps {
				for tx in 0..<taps {
					sx := src.X + min(src.Width-1, int((f32(dx) + (f32(tx)+0.5)/f32(taps))*scale))
					sy := src.Y + min(src.Height-1, int((f32(dy) + (f32(ty)+0.5)/f32(taps))*scale))
					p := image.Pixels[sy*image.Width + sx]
					a := f32(p.A)/255
					sum += {f32(p.R)*a, f32(p.G)*a, f32(p.B)*a, a}
				}
			}
			n := f32(taps*taps)
			out: foster.Color
			if sum[3] > 0 {
				out = {u8(math.round(sum[0]/sum[3])), u8(math.round(sum[1]/sum[3])),
					u8(math.round(sum[2]/sum[3])), u8(math.round(sum[3]/n*255))}
			}
			sheet.Pixels[(y+dy)*sheet.Width + x+dx] = out
		}
	}
}

@(private)
icon_uv :: proc(icons: ^Icons, name: string) -> ([2]imgui.Vec2, bool) {
	if icons == nil {
		return {}, false
	}
	uv, found := icons.uvs[name]
	return uv, found
}

// Icon draws a named icon as an image item of size x size points. Missing
// names (or a nil sheet) leave an empty gap of the same size.
Icon :: proc(icons: ^Icons, name: string, size: f32, tint: imgui.Vec4 = {1, 1, 1, 1}) {
	uv, found := icon_uv(icons, name)
	if !found {
		imgui.Dummy({size, size})
		return
	}
	imgui.ImageWithBg(Texture(&icons.texture), {size, size}, uv[0], uv[1], {0, 0, 0, 0}, tint)
}

// IconButton is a framed button with an icon followed by an optional label.
// width 0 fits the content, < 0 fills the remaining row. selected draws it with
// the header colors (for toggles and tabs). id must be unique in the window.
IconButton :: proc(icons: ^Icons, id, icon: string, label: string = "", selected := false, width: f32 = 0) -> bool {
	style := imgui.GetStyle()
	text := strings.clone_to_cstring(label, context.temp_allocator)
	text_size := label != "" ? imgui.CalcTextSize(text) : imgui.Vec2{}
	height := imgui.GetFrameHeight()
	icon_size := math.round(imgui.GetFontSize()*1.25)
	uv, has_icon := icon_uv(icons, icon)
	content := text_size.x
	if has_icon {
		content += icon_size + (label != "" ? style.ItemInnerSpacing.x : 0)
	}
	size := imgui.Vec2{content + style.FramePadding.x*2, height}
	if width > 0 {
		size.x = width
	} else if width < 0 {
		size.x = max(size.x, imgui.GetContentRegionAvail().x)
	}
	if selected {
		imgui.PushStyleColor(.Button, imgui.GetColorU32(.Header))
		imgui.PushStyleColor(.ButtonHovered, imgui.GetColorU32(.HeaderHovered))
		imgui.PushStyleColor(.ButtonActive, imgui.GetColorU32(.HeaderActive))
	}
	clicked := imgui.Button(fmt.ctprintf("##%s", id), size)
	if selected {
		imgui.PopStyleColor(3)
	}
	origin := imgui.GetItemRectMin()
	draw := imgui.GetWindowDrawList()
	x := origin.x + style.FramePadding.x
	color := imgui.GetColorU32(selected ? .CheckMark : .Text)
	if has_icon {
		y := origin.y + math.round((height - icon_size)/2)
		imgui.DrawList_AddImage(draw, Texture(&icons.texture), {x, y}, {x + icon_size, y + icon_size}, uv[0], uv[1], color)
		x += icon_size + style.ItemInnerSpacing.x
	}
	if label != "" {
		imgui.DrawList_AddText(draw, {x, origin.y + style.FramePadding.y}, color, text)
	}
	return clicked
}
