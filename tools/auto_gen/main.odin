// auto_gen —— 收集 Odin 声明上的 tag，生成同包枚举；不执行或推断玩法逻辑。
package main

import "core:fmt"
import "core:mem/virtual"
import "core:os"
import "core:path/filepath"
import "core:strings"

// 分区：命令行 / 文件更新。

// ------------------------------------------------------------------------------
// 命令行
// ------------------------------------------------------------------------------

Options :: struct {
	source:    string,
	tag:       string,
	enum_name: string,
	output:    string,
	check:     bool,
}

main :: proc() {
	os.exit(run_cli(os.args[1:]))
}

run_cli :: proc(args: []string) -> int {
	// AST、源码和生成文本共用本次调用的 arena，不把解析器分配泄漏到常驻调用者。
	arena: virtual.Arena
	if virtual.arena_init_growing(&arena) != nil do return 1
	defer virtual.arena_destroy(&arena)
	context.allocator = virtual.arena_allocator(&arena)
	if len(args) == 0 || (len(args) == 1 && args[0] == "-help") {
		fmt.println("用法: odin run tools/auto_gen -- -source <包目录> -tag <标签> -enum <枚举名> -out <文件> [-check]")
		return 0 if len(args) > 0 else 2
	}
	options, error := parse_options(args)
	if error != "" {
		fmt.eprintln(error)
		return 2
	}
	content, generate_error := generate(options)
	if generate_error != "" {
		fmt.eprintln(generate_error)
		return 1
	}
	changed, write_error := update_output(options.output, content, options.check)
	if write_error != "" {
		fmt.eprintln(write_error)
		return 1
	}
	fmt.printfln("%s: %s", "已生成" if changed else "已是最新", options.output)
	return 0
}

parse_options :: proc(args: []string) -> (Options, string) {
	options: Options
	seen: map[string]bool
	for i := 0; i < len(args); i += 1 {
		arg := args[i]
		if seen[arg] do return {}, fmt.aprintf("重复参数: %s", arg)
		seen[arg] = true
		if arg == "-check" {
			options.check = true
			continue
		}
		if arg != "-source" && arg != "-tag" && arg != "-enum" && arg != "-out" {
			return {}, fmt.aprintf("未知参数: %s", arg)
		}
		if i+1 == len(args) do return {}, fmt.aprintf("参数缺少值: %s", arg)
		i += 1
		switch arg {
		case "-source":
			options.source = args[i]
		case "-tag":
			options.tag = args[i]
		case "-enum":
			options.enum_name = args[i]
		case "-out":
			options.output = args[i]
		}
	}
	if options.source == "" || options.tag == "" || options.output == "" ||
	   !valid_identifier(options.enum_name) {
		return {}, "必须提供 -source、非空 -tag、有效 Odin 标识符 -enum 和 -out。"
	}
	source, source_error := filepath.abs(options.source)
	output, output_error := filepath.abs(options.output)
	if source_error != nil || output_error != nil do return {}, "无法解析输入或输出路径。"
	options.source = source
	options.output = output
	if !same_path(filepath.dir(output), source) || !strings.has_suffix(output, ".odin") ||
	   strings.has_suffix(output, "_test.odin") || conditional_filename(output) {
		return {}, "输出必须是源码包目录内的 .odin 文件，不可带测试或平台后缀。"
	}
	return options, ""
}

same_path :: proc(a, b: string) -> bool {
	when ODIN_OS == .Windows {
		return strings.equal_fold(a, b)
	} else {
		return a == b
	}
}

// ------------------------------------------------------------------------------
// 文件更新
// ------------------------------------------------------------------------------

GENERATED_HEADER :: "// Code generated by olib tools/auto_gen. DO NOT EDIT.\n"

// 不改写相同内容；已有手写文件不覆盖。临时文件在目标同目录，关闭后一次替换。
update_output :: proc(path, content: string, check: bool) -> (changed: bool, error: string) {
	previous, read_error := os.read_entire_file(path, context.allocator)
	if read_error == nil {
		// Git autocrlf 可能转换正式生成源码；仅换行差异不应触发重写或覆盖保护。
		normalized, _ := strings.replace_all(string(previous), "\r\n", "\n", context.allocator)
		if normalized == content do return false, ""
		if !strings.has_prefix(normalized, GENERATED_HEADER) {
			return false, fmt.aprintf("拒绝覆盖非 auto_gen 文件: %s", path)
		}
	} else if read_error != .Not_Exist {
		return false, fmt.aprintf("无法读取 %s: %v", path, read_error)
	}
	if check do return false, fmt.aprintf("生成文件缺失或已过期: %s", path)
	file, create_error := os.create_temp_file(filepath.dir(path), ".auto_gen-*.tmp")
	if create_error != nil do return false, fmt.aprintf("无法创建临时文件: %v", create_error)
	temporary := strings.clone(os.name(file))
	defer os.remove(temporary)
	n, write_error := os.write(file, transmute([]u8)content)
	close_error := os.close(file)
	if write_error != nil || n != len(content) || close_error != nil {
		return false, fmt.aprintf("无法完整写入 %s: %v / %v", temporary, write_error, close_error)
	}
	if rename_error := os.rename(temporary, path); rename_error != nil {
		return false, fmt.aprintf("无法替换 %s: %v", path, rename_error)
	}
	return true, ""
}
