package core_editor

import "core:encoding/json"
import "core:math"

import foster "olib:foster"
import r2d "olib:kit/rendering/2d"
import imgui "olib:thirdparty/odin-imgui"
import imgui_foster "olib:thirdparty/odin-imgui/imgui_impl_ofoster"

// 分区：编辑会话与设置 / 输入归属 / 运行时编辑命令 / 面板绘制。
// 编辑当前试玩实例，不写场景文件、不维护文档撤销历史。
// DLL 拥有会话和本 DLL 的 ImGui 上下文；State（含 Dock 布局与界面字号）与待处理命令进入快照，
// ImGui 上下文、GPU 对象与瞬时输入重建。界面字号另存为用户存储里的编辑器设置，重启后保留。
TITLE :: "Live Editor"
DOCK_ID :: "editor-dock"
// 首次打开时面板占窗口宽度的比例；之后以拖动结果为准，随快照保留。
PANEL_RATIO :: f32(0.3)
// 界面字号（ImGui 点，显示器 DPI 另乘）；ImGui 按实际字号光栅化，任意大小都清晰。
// 1080p 的默认值；更高分辨率且系统未缩放时按屏幕放大，见 font_size_default。
FONT_SIZE_DEFAULT :: f32(18)
FONT_SIZE_MIN :: f32(12)
FONT_SIZE_MAX :: f32(32)
// 编辑器偏好，与游戏存档同一用户存储但独立文件；不写入内容文档。
SETTINGS_PATH :: "editor-settings.json"
// ImGuiDockNodeFlags_DockSpace 是 imgui_internal.h 的私有位，绑定里没有生成。
DOCK_NODE_DOCKSPACE :: transmute(imgui.DockNodeFlags)i32(1 << 10)
// 面板用到的 olib 内置图标（名称见 olib assets/icons/game-icons.xml）。新增按钮图标时加进这里。
ICON_NAMES :: [?]string{"symbols/minus", "symbols/plus", "media/play", "media/pause", "ui/refresh"}
// 图标表每格像素：约为默认字号下 IconButton 绘制尺寸的 2 倍，调大字号或高 DPI 时仍够用。
ICON_CELL :: 48
Edit_Kind :: enum { Set_Position, Score_Down, Score_Up, Toggle_Pause }
Edit_Command :: struct { kind: Edit_Kind, value: f32 }
Preview :: struct { x: f32, score: i64, paused: bool }
State :: struct {
	open: bool,
	layout: string, // ImGui ini 文本：Dock 分割与窗口位置，Session 拥有
	font_size: f32,
}
Settings :: struct {
	font_size: f32,
}
Pointer_Owner :: enum {
	None,
	Game,
	Editor,
	Discard,
}
Session :: struct {
	state: State,
	pending: [dynamic]Edit_Command,
	game_view: foster.Rect, // 上一帧中央 Dock 节点的最终像素区域；宽度为 0 表示整窗
	owner: Pointer_Owner,
	previous_down, ready: bool,
	gui: bool, // 本 DLL 的 ImGui 上下文与后端已创建
	icons: imgui_foster.Icons, // 从内置图集挑出 ICON_NAMES 的小图标表，随 DLL 重建
	font_edit: f32, // 拖动字号滑条时的临时值，松开才生效，避免控件边拖边变大
	font_default: f32, // 本显示器的建议字号，Reset 回到它
	font_editing, settings_dirty: bool,
}
Input :: struct {
	game_mouse: foster.Vec2,
	game_down, block_keys: bool,
}

// 在 load 中调用：每个 DLL 副本创建自己的上下文，并恢复快照里的布局。
init :: proc(e: ^Session, app: ^foster.App, scale: f32) -> bool {
	// 不开键盘导航：方向键/空格留给游戏，避免同一按键被面板和游戏同时处理。
	if !imgui_foster.Init(app, {.DockingEnable}) do return false
	e.gui = true
	e.font_default = font_size_default(app)
	io := imgui.GetIO()
	io.IniFilename = nil // 布局只随快照保留，不在工作目录写 imgui.ini
	if scale != 1 {
		style := imgui.GetStyle()
		imgui.Style_ScaleAllSizes(style, scale)
		style.FontScaleMain = scale
	}
	if e.state.layout != "" {
		imgui.LoadIniSettingsFromMemory(cstring(raw_data(e.state.layout)), uint(len(e.state.layout)))
	}
	// 解码整张内置图集（约 64 MiB 临时像素），挑出的图标表建好后立即释放。
	image, rects, decoded := r2d.builtin_icons_decode()
	if !decoded do return false
	defer delete(image.Pixels)
	defer r2d.kenney_rects_dispose(rects)
	names := ICON_NAMES
	return imgui_foster.IconsInit(&e.icons, &app.GraphicsDevice, image, rects^, names[:], ICON_CELL)
}

dispose :: proc(e: ^Session) {
	imgui_foster.IconsDispose(&e.icons)
	if e.gui do imgui_foster.Shutdown()
	e.gui = false
	delete(e.state.layout)
	delete(e.pending)
}

// 非法或缺失的字号回到默认值，范围外的夹到上下限。
font_size_valid :: proc(size: f32) -> f32 {
	if math.is_nan(size) || math.is_inf(size) || size <= 0 do return FONT_SIZE_DEFAULT
	return math.round(math.clamp(size, FONT_SIZE_MIN, FONT_SIZE_MAX))
}

// 没有设置文件时的建议字号：系统缩放为 100% 而屏幕分辨率高（1440p、4K 等）时按屏幕高度放大，
// 最多 1.75 倍；系统已有缩放时 ImGui 后端已经乘过 DPI，不再叠加。
font_size_default :: proc(app: ^foster.App) -> f32 {
	if app == nil do return FONT_SIZE_DEFAULT
	display := foster.DisplaySize(&app.Window)
	if display.Y <= 0 || foster.ContentScale(&app.Window) > 1.01 do return FONT_SIZE_DEFAULT
	return font_size_valid(FONT_SIZE_DEFAULT*math.clamp(f32(display.Y)/1080, 1, 1.75))
}

// 没有文件、读不到或格式不对时 found=false，不阻止编辑器启动。
settings_load :: proc(storage: ^foster.StorageContainer) -> (settings: Settings, found: bool) {
	if storage == nil || !foster.FileExists(storage, SETTINGS_PATH) do return
	bytes := foster.ReadAllBytes(storage, SETTINGS_PATH, context.temp_allocator)
	if json.unmarshal(bytes, &settings, allocator = context.temp_allocator) != nil do return {}, false
	settings.font_size = font_size_valid(settings.font_size)
	return settings, true
}

// 同目录临时文件替换，失败保留旧文件。只在已提交模块的 Update 中调用，候选 load 不写盘。
settings_save :: proc(storage: ^foster.StorageContainer, settings: Settings) -> bool {
	if storage == nil do return false
	bytes, err := json.marshal(settings, {pretty = true}, context.temp_allocator)
	return err == nil && foster.WriteAllBytesAtomic(storage, SETTINGS_PATH, bytes)
}

// 帧外调用；结果借用 ImGui 内存，只在下一次调用 ImGui 前有效。
layout_text :: proc(e: ^Session) -> string {
	if !e.gui do return e.state.layout
	return string(imgui.SaveIniSettingsToMemory())
}

toggle :: proc(e: ^Session) {
	e.state.open = !e.state.open
	// 隐藏/重新打开不能把尚未松开的按键转交给另一边。
	e.owner = .Discard
	e.ready = false
}

// over_editor：面板打开且 ImGui 要鼠标（悬停在面板上，或正拖动面板里的控件）。
route :: proc(e: ^Session, mouse: foster.Vec2, down, focused, over_editor: bool) -> (input: Input) {
	input.game_mouse = {-10000, -10000}
	if !focused {
		e.owner = .Discard
		e.ready = false
		input.block_keys = true
		return
	}
	if !down {
		e.ready = true
		if !e.previous_down do e.owner = .None
	}
	if down && !e.previous_down {
		e.owner = !e.ready ? .Discard : over_editor ? .Editor : .Game
	}
	e.previous_down = down
	input.block_keys = over_editor || e.owner == .Editor || e.owner == .Discard
	// 归属保持到松开帧；游戏的拖动经过面板仍会收到松开，但不会激活面板。
	if e.owner == .Game || (!down && e.owner == .None && !over_editor) {
		input.game_mouse = mouse
		input.game_down = down
	}
	return
}

// 每次 Update 调用：按上一帧 ImGui 的悬停结果分配输入，再把原始输入交给 ImGui。
update_input :: proc(e: ^Session, app: ^foster.App, mouse: foster.Vec2, down, focused: bool, dt: f32) -> Input {
	if !e.gui || !e.state.open do return route(e, mouse, down, focused, false)
	io := imgui.GetIO()
	input := route(e, mouse, down, focused, io.WantCaptureMouse)
	input.block_keys ||= io.WantTextInput
	// 重载、F1 或离焦时按住的鼠标先松开，ImGui 不能把它当作新的点击。
	if e.owner == .Discard {
		io.ConfigFlags += {.NoMouse}
	} else {
		io.ConfigFlags -= {.NoMouse}
	}
	imgui_foster.NewFrame(app, dt)
	return input
}

// 每次 Render 在游戏之后调用；中央节点的区域留给下一帧的游戏绘制和输入。
draw :: proc(e: ^Session, w: ^Preview, app: ^foster.App) {
	if !e.gui || !e.state.open {
		e.game_view = {}
		return
	}
	// 字号只能在帧外改，下一帧按新字号光栅化。
	imgui.GetStyle().FontSizeBase = e.state.font_size
	if !imgui_foster.BeginRender(app) do return
	dock := imgui.GetID(DOCK_ID)
	if imgui.DockBuilderGetNode(dock) == nil do default_layout(dock, imgui.GetMainViewport().WorkSize)
	imgui.DockSpaceOverViewport(dock, nil, {.PassthruCentralNode, .NoDockingOverCentralNode})
	if imgui.Begin(TITLE) do panel(e, w)
	imgui.End()
	if central := imgui.DockBuilderGetCentralNode(dock); central != nil {
		scale := imgui.GetIO().DisplayFramebufferScale
		e.game_view = {central.Pos.x*scale.x, central.Pos.y*scale.y,
			central.Size.x*scale.x, central.Size.y*scale.y}
	}
	imgui_foster.EndRender(app)
}

// 没有快照布局时：面板停靠右侧，中央节点留给游戏。
default_layout :: proc(dock: imgui.ID, size: imgui.Vec2) {
	imgui.DockBuilderAddNode(dock, DOCK_NODE_DOCKSPACE)
	imgui.DockBuilderSetNodeSize(dock, size)
	panel, center: imgui.ID
	imgui.DockBuilderSplitNode(dock, .Right, PANEL_RATIO, &panel, &center)
	imgui.DockBuilderDockWindow(TITLE, panel)
	imgui.DockBuilderFinish(dock)
}

// 控件只追加命令，由下一次 Update 经 core 规则校验后生效。
panel :: proc(e: ^Session, w: ^Preview) {
	imgui.TextDisabled("F1: hide / show")
	if imgui.CollapsingHeader("Game", {.DefaultOpen}) {
		x := w.x
		// 滑条让出右侧标签的宽度，字号调大后标签不被面板边缘截断。
		imgui.SetNextItemWidth(-(imgui.CalcTextSize("Position").x + imgui.GetStyle().ItemInnerSpacing.x))
		if imgui.SliderFloat("Position", &x, 20, 580, "%.0f", imgui.SliderFlags_AlwaysClamp) {
			append(&e.pending, Edit_Command{kind = .Set_Position, value = x})
		}
		imgui.Text("Score: %lld", w.score)
		imgui.SameLine()
		if imgui_foster.IconButton(&e.icons, "score-down", "symbols/minus") {
			append(&e.pending, Edit_Command{kind = .Score_Down})
		}
		imgui.SameLine()
		if imgui_foster.IconButton(&e.icons, "score-up", "symbols/plus") {
			append(&e.pending, Edit_Command{kind = .Score_Up})
		}
		// id 固定，图标和文字切换时控件身份不变。
		if imgui_foster.IconButton(&e.icons, "pause", w.paused ? "media/play" : "media/pause",
			w.paused ? "Resume" : "Pause") {
			append(&e.pending, Edit_Command{kind = .Toggle_Pause})
		}
	}
	imgui.TextDisabled("Changes affect this run.")
	if imgui.CollapsingHeader("Editor") {
		if !e.font_editing do e.font_edit = e.state.font_size
		imgui.SetNextItemWidth(imgui.GetFontSize()*9)
		imgui.SliderFloat("UI font size", &e.font_edit, FONT_SIZE_MIN, FONT_SIZE_MAX, "%.0f px", imgui.SliderFlags_AlwaysClamp)
		e.font_editing = imgui.IsItemActive()
		if imgui.IsItemDeactivatedAfterEdit() do font_size_set(e, e.font_edit)
		imgui.SameLine()
		if imgui_foster.IconButton(&e.icons, "font-size-reset", "ui/refresh", "Reset") {
			font_size_set(e, e.font_default)
		}
	}
}

font_size_set :: proc(e: ^Session, requested: f32) {
	size := font_size_valid(requested)
	if size == e.state.font_size do return
	e.state.font_size = size
	e.settings_dirty = true
}
