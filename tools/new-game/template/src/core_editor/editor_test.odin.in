#+test
package core_editor

import "core:fmt"
import "core:os"
import "core:testing"

import foster "olib:foster"

@(test)
pointer_ownership_survives_leaving_panel_and_cancels_on_hide :: proc(t: ^testing.T) {
	e := Session{state = {open = true}}
	_ = route(&e, {800, 100}, false, true, true)
	press := route(&e, {800, 100}, true, true, true)
	testing.expect(t, e.owner == .Editor && !press.game_down && press.block_keys)
	// 拖出面板后 ImGui 仍持有这次按下，游戏不能接收。
	drag := route(&e, {100, 100}, true, true, false)
	testing.expect(t, !drag.game_down && drag.block_keys)
	toggle(&e)
	held := route(&e, {100, 100}, true, true, false)
	testing.expect(t, e.owner == .Discard && !held.game_down)
	_ = route(&e, {100, 100}, false, true, false)
	routed := route(&e, {100, 100}, true, true, false)
	testing.expect(t, e.owner == .Game && routed.game_down && !routed.block_keys)
	// 游戏的拖动经过面板仍归游戏，直到松开。
	crossing := route(&e, {800, 100}, true, true, true)
	testing.expect(t, e.owner == .Game && crossing.game_down)
	lost := route(&e, {100, 100}, true, false, false)
	testing.expect(t, lost.block_keys && !lost.game_down)
}

@(test)
font_size_settings_validate_and_round_trip :: proc(t: ^testing.T) {
	testing.expect_value(t, font_size_valid(0), FONT_SIZE_DEFAULT)
	testing.expect_value(t, font_size_valid(100), FONT_SIZE_MAX)
	testing.expect_value(t, font_size_valid(20.4), f32(20))
	_, found := settings_load(nil)
	testing.expect(t, !found)
	testing.expect_value(t, font_size_default(nil), FONT_SIZE_DEFAULT)
	root, err := os.make_directory_temp("", "editor_settings_", context.allocator)
	if !testing.expect(t, err == nil) do return
	defer delete(root)
	defer os.remove(root)
	storage := foster.StorageContainer{Root = root, Writable = true}
	defer os.remove(fmt.tprintf("%s/%s", root, SETTINGS_PATH))
	_, found = settings_load(&storage)
	testing.expect(t, !found)
	testing.expect(t, settings_save(&storage, {font_size = 24}))
	settings: Settings
	settings, found = settings_load(&storage)
	testing.expect(t, found && settings.font_size == 24)
	testing.expect(t, foster.WriteAllBytes(&storage, SETTINGS_PATH, transmute([]u8)string("not json")))
	_, found = settings_load(&storage)
	testing.expect(t, !found)
}

@(test)
headless_session_keeps_layout_text :: proc(t: ^testing.T) {
	e := Session{state = {layout = "[Docking][Data]\n"}}
	testing.expect_value(t, layout_text(&e), "[Docking][Data]\n")
}
