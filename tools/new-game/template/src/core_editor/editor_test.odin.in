#+test
package core_editor

import "core:testing"

@(test)
pointer_ownership_survives_leaving_panel_and_cancels_on_hide :: proc(t: ^testing.T) {
	e := Session{state = {open = true}}
	_, panel := viewports(true, 960, 720, 1)
	_ = route(&e, panel, {800, 100}, false, true)
	press := route(&e, panel, {800, 100}, true, true)
	testing.expect(t, press.editor_down && !press.game_down && press.block_keys)
	drag := route(&e, panel, {100, 100}, true, true)
	testing.expect(t, drag.editor_down && !drag.game_down && drag.block_keys)
	toggle(&e)
	held := route(&e, panel, {100, 100}, true, true)
	testing.expect(t, !held.editor_down && !held.game_down)
	_ = route(&e, panel, {100, 100}, false, true)
	routed := route(&e, panel, {100, 100}, true, true)
	testing.expect(t, routed.game_down && !routed.editor_down)
	lost := route(&e, panel, {100, 100}, true, false)
	testing.expect(t, lost.block_keys && !lost.game_down && !lost.editor_down)
}
