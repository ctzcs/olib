#+test
package core_editor

import "core:strings"
import "core:testing"
import reload "olib:core/hotreload"
import "game:core"

@(test)
game_and_editor_snapshot_own_state_and_commands :: proc(t: ^testing.T) {
	services := core.Services{headless = true}
	ctx := context
	first := reload.Call{host_context = &ctx, services = &services}
	testing.expect(t, module_load(&first, {}))
	defer module_unload(&first)
	a := cast(^Module_Instance)first.instance
	a.tools.state.open = false
	a.tools.state.layout = strings.clone("[Docking][Data]\n")
	testing.expect_value(t, a.tools.state.font_size, FONT_SIZE_DEFAULT)
	a.tools.state.font_size = 24
	a.tools.owner = .Editor
	a.tools.ready = true
	a.tools.previous_down = true
	append(&a.tools.pending, Edit_Command{kind = .Set_Position, value = 125},
		Edit_Command{kind = .Score_Up}, Edit_Command{kind = .Toggle_Pause})
	append(&a.game.state.pending, core.Commands{add_point = true})
	core.apply(&a.game.state.world, {add_point = true})
	bytes := make([]u8, module_snapshot_size(&first))
	defer delete(bytes)
	testing.expect(t, module_save(&first, bytes))
	second := reload.Call{host_context = &ctx, services = &services}
	testing.expect(t, module_load(&second, {data = bytes, version = MODULE_STATE_VERSION}))
	defer module_unload(&second)
	b := cast(^Module_Instance)second.instance
	testing.expect(t, !b.tools.state.open && !b.tools.ready && !b.tools.previous_down)
	testing.expect_value(t, b.tools.owner, .Discard)
	testing.expect_value(t, b.tools.state.layout, a.tools.state.layout)
	testing.expect_value(t, b.tools.state.font_size, f32(24))
	testing.expect(t, raw_data(b.tools.state.layout) != raw_data(a.tools.state.layout))
	testing.expect(t, raw_data(b.tools.pending) != raw_data(a.tools.pending))
	testing.expect(t, raw_data(b.game.state.pending) != raw_data(a.game.state.pending))
	testing.expect(t, raw_data(b.game.state.world.history) != raw_data(a.game.state.world.history))
	module_update(&second, 0)
	module_update(&second, 0)
	testing.expect(t, b.game.state.world.x == 125 && b.game.state.world.score == core.POINTS*2+1)
	testing.expect(t, b.game.state.world.paused && len(b.tools.pending) == 0 && len(b.game.state.pending) == 0)
	testing.expect(t, a.game.state.world.x == 100 && a.game.state.world.score == core.POINTS)
	testing.expect(t, len(a.tools.pending) == 3 && len(a.game.state.pending) == 1)
	// 版本/格式拒绝后的候选可清理，不能消费旧会话命令或修改宿主。
	for version in ([]u64{MODULE_STATE_VERSION+1, MODULE_STATE_VERSION}) {
		rejected := reload.Call{host_context = &ctx, services = &services}
		testing.expect(t, !module_load(&rejected, {data = transmute([]u8)string(`{"game":[123]}`), version = version}))
		module_unload(&rejected)
	}
	// 越界的编辑命令被拒绝，候选连同已解码的布局一起释放。
	append(&a.tools.pending, Edit_Command{kind = .Set_Position, value = 1e9})
	invalid := make([]u8, module_snapshot_size(&first))
	defer delete(invalid)
	testing.expect(t, module_save(&first, invalid))
	rejected := reload.Call{host_context = &ctx, services = &services}
	testing.expect(t, !module_load(&rejected, {data = invalid, version = MODULE_STATE_VERSION}))
	module_unload(&rejected)
	testing.expect(t, len(a.tools.pending) == 4 && !services.input.down)
}

@(test)
reload_discards_held_pointer_until_release :: proc(t: ^testing.T) {
	e := Session{state = {open = true}, owner = .Discard}
	input := route(&e, {900, 50}, true, true, true)
	testing.expect(t, !input.game_down && input.block_keys)
	input = route(&e, {100, 50}, true, true, false)
	testing.expect(t, !input.game_down)
	_ = route(&e, {100, 50}, false, true, false)
	input = route(&e, {100, 50}, true, true, false)
	testing.expect(t, input.game_down && e.owner == .Game)
	input = route(&e, {900, 50}, false, true, true)
	testing.expect(t, !input.game_down)
}
